{
	"schemaVersion": 1,
	"id": "immersiveminimaps",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"cassiancc"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/immersive-minimaps",
		"sources": "https://github.com/cassiancc/Immersive-Minimaps",
		"issues": "https://github.com/cassiancc/Immersive-Minimaps/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/immersiveminimaps/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"cc.cassian.immersiveminimaps.ModClient"
		]
	},
	"mixins": [
		"immersiveminimaps.mixins.json"
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "${minecraft}",
		"fabric-api": "*",
		"surveyor": ">=1.0.0",
		"hoofprint": ">=1.0.0"
	},
	"recommends": {
		"immersiveoverlays": "*",
		"mcqoy": "*"
	},
	"custom": {
		"launchpad:compatible": true,
		"launchpad:overrides": {
			"depends": {
				"minecraft": "${minecraft}",
				"fabric_api_base": "*",
				"fabric_command_api_v2": "*",
				"fabric_networking_api_v1": "*",
				"fabric_lifecycle_events_v1": "*",
				"fabric_key_mapping_api_v1": "*",
				"surveyor": "*",
				"hoofprint": "*"
			}
		}
	}

}